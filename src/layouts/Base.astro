---
import "../styles/global.css";
import { site, nav, notebook, activeSocials } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  image?: string;
  keywords?: string[];
}
const { title, description = site.description, type = "website", image = "/images/author.jpg", keywords = [] } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : `${site.title} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const socials = activeSocials();
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join("، ")} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title ?? site.title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="ar_AR" />
  <meta property="og:image" content={new URL(image, site.url).href} />
  <meta name="twitter:card" content={type === "article" ? "summary_large_image" : "summary"} />
  <meta name="theme-color" content="#13294b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script is:inline>
    try {
      const t = localStorage.getItem("theme");
      if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches)) document.documentElement.classList.add("dark");
    } catch (e) {}
  </script>
  <!-- إحصاء الزوار: GoatCounter -->
  <script is:inline data-goatcounter="https://almaljamie.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:right-2 focus:z-50 bg-saffron text-ink px-4 py-2 rounded">انتقل إلى المحتوى</a>

  <header id="top" class="sticky top-0 z-40 bg-[var(--bg)]/90 backdrop-blur border-b border-[var(--rule)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-8 h-[4.5rem] sm:h-20 flex items-center gap-3 sm:gap-6">
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 min-w-0 no-underline" aria-label="الصفحة الرئيسية">
        <svg viewBox="0 0 44 44" class="w-10 h-10 sm:w-11 sm:h-11 shrink-0" aria-hidden="true">
          <rect width="44" height="44" rx="10" fill="#13294b" />
          <path d="M8 36V23a14 14 0 0 1 28 0v13z" fill="#fff" />
          <path d="M12 23a10 10 0 0 1 20 0z" fill="#c8962e" />
          <path d="M22 13v10M14.9 15.9 22 23M29.1 15.9 22 23" stroke="#fff" stroke-width="2" />
          <path d="M12 26.5h20v7H12z" fill="#13294b" />
          <path d="M18.7 26.5v7M25.3 26.5v7" stroke="#fff" stroke-width="1.6" />
        </svg>
        <span class="flex flex-col leading-tight min-w-0">
          <span class="text-[1.05rem] sm:text-[1.2rem] font-bold truncate">{site.title}</span>
          <span class="hidden sm:block text-[0.8rem] text-[var(--muted)] truncate">{site.headerTagline}</span>
        </span>
      </a>

      <nav aria-label="القائمة الرئيسية" class="hidden lg:flex items-center gap-1 ms-auto text-[0.98rem] font-medium">
        {nav.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}
             class:list={["relative px-3 py-2 no-underline transition-colors hover:text-indigo dark:hover:text-saffron",
               isActive(l.href) ? "text-indigo dark:text-saffron after:absolute after:inset-x-3 after:-bottom-[1px] after:h-[2px] after:bg-saffron" : "text-[var(--muted)]"]}>{l.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-0.5 sm:gap-1 ms-auto lg:ms-2 shrink-0">
        <a href={notebook.href} class="hidden sm:inline-flex items-center gap-2 me-2 px-4 py-2 rounded-full bg-indigo text-white text-[0.92rem] font-medium no-underline hover:bg-indigo-deep dark:bg-saffron dark:text-ink transition-colors">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11"/><path d="M12 6.5l.8 1.7 1.7.8-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.8z" fill="currentColor"/></svg>
          {notebook.label}
        </a>
        {socials.map((s) => (
          <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} class="hidden md:grid place-items-center w-9 h-9 rounded-full text-[var(--muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-2)]">
            <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="currentColor" aria-hidden="true"><path d={s.d} /></svg>
          </a>
        ))}
        <button id="open-search" type="button" class="grid place-items-center w-9 h-9 rounded-full text-[var(--muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-2)]" aria-label="بحث في الموقع">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
        <button id="theme" type="button" class="max-[359px]:hidden grid place-items-center w-9 h-9 rounded-full text-[var(--muted)] hover:text-[var(--fg)] hover:bg-[var(--bg-2)]" aria-label="تبديل الوضع الليلي">
          <svg viewBox="0 0 24 24" class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>
          <svg viewBox="0 0 24 24" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <button id="menu" type="button" class="lg:hidden grid place-items-center w-10 h-10 rounded-full hover:bg-[var(--bg-2)]" aria-label="القائمة" aria-expanded="false" aria-controls="mobile-nav">
          <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </div>
    <nav id="mobile-nav" hidden aria-label="القائمة" class="lg:hidden border-t border-[var(--rule)] px-5 pb-4 bg-[var(--bg)]">
      {nav.map((l) => (
        <a href={l.href} class:list={["block py-3 no-underline border-b border-[var(--rule)]", isActive(l.href) ? "text-indigo dark:text-saffron font-bold" : ""]}>{l.label}</a>
      ))}
      <a href={notebook.href} class="mt-4 flex justify-center px-4 py-2.5 rounded-full bg-indigo text-white no-underline dark:bg-saffron dark:text-ink">{notebook.label}</a>
    </nav>
  </header>

  <main id="main" class="flex-1">
    <slot />
  </main>

  <footer class="mt-24 bg-indigo-deep text-white/75 pattern">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-14 grid gap-10 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <p class="text-xl font-bold text-white">{site.title}</p>
        <p class="mt-1 text-saffron">{site.tagline}</p>
        <p class="mt-4 leading-loose max-w-sm">أكتب عن المجتمع اليمني: كيف يفكّر، وكيف يتغيّر. وأنشر هنا دراساتي متاحة للتنزيل مجانًا.</p>
      </div>
      <div>
        <p class="font-bold text-white mb-3">روابط</p>
        <ul class="space-y-2">
          {[...nav.slice(1), notebook, { href: "/contact/", label: "تواصل" }].map((l) => <li><a class="no-underline hover:text-saffron" href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-bold text-white mb-3">تابعني</p>
        {socials.length ? (
          <div class="flex flex-wrap gap-2">
            {socials.map((s) => (
              <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} class="grid place-items-center w-10 h-10 rounded-full bg-white/10 hover:bg-saffron hover:text-ink transition-colors">
                <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="currentColor" aria-hidden="true"><path d={s.d} /></svg>
              </a>
            ))}
          </div>
        ) : <p>حسابات التواصل تُضاف قريبًا.</p>}
        <a class="inline-block mt-4 no-underline hover:text-saffron" href="/rss.xml">خلاصة RSS</a>
      </div>
    </div>
    <div class="border-t border-white/10">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 py-5 flex flex-wrap justify-between gap-3 text-[0.9rem] text-white/55">
        <p>جميع الحقوق محفوظة © {new Date().getFullYear()} {site.title}</p>
        <a href="#top" class="no-underline hover:text-white">العودة إلى الأعلى</a>
      </div>
    </div>
  </footer>

  <dialog id="search" class="m-auto mt-[10vh] w-[min(42rem,92vw)] rounded-2xl p-0 bg-[var(--bg)] text-[var(--fg)] backdrop:bg-indigo-deep/70 backdrop:backdrop-blur-sm">
    <div class="flex items-center justify-between px-5 pt-4">
      <p class="text-lg font-bold">ابحث في المقالات والدراسات</p>
      <button type="button" data-close class="p-1.5 rounded-md hover:bg-[var(--bg-2)]" aria-label="إغلاق البحث">
        <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <div id="pagefind" class="p-5 pt-3 max-h-[70vh] overflow-y-auto"></div>
  </dialog>

  <script>
    const root = document.documentElement;
    document.getElementById("theme")?.addEventListener("click", () => {
      const dark = root.classList.toggle("dark");
      try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) {}
    });
    const menu = document.getElementById("menu");
    const mnav = document.getElementById("mobile-nav");
    menu?.addEventListener("click", () => {
      const open = mnav!.hidden;
      mnav!.hidden = !open;
      menu.setAttribute("aria-expanded", String(open));
    });
    const dlg = document.getElementById("search") as HTMLDialogElement;
    let loaded = false;
    async function openSearch() {
      dlg.showModal();
      if (!loaded) {
        loaded = true;
        try {
          const link = document.createElement("link");
          link.rel = "stylesheet"; link.href = "/pagefind/pagefind-ui.css";
          document.head.append(link);
          await new Promise<void>((res, rej) => {
            const s = document.createElement("script");
            s.src = "/pagefind/pagefind-ui.js"; s.onload = () => res(); s.onerror = () => rej();
            document.head.append(s);
          });
          // @ts-ignore
          new window.PagefindUI({ element: "#pagefind", showSubResults: true, showImages: false,
            translations: { placeholder: "اكتب كلمة أو عبارة", zero_results: "لا نتائج لـ «[SEARCH_TERM]». جرّب كلمة أخرى.", many_results: "[COUNT] نتيجة لـ «[SEARCH_TERM]»", one_result: "نتيجة واحدة لـ «[SEARCH_TERM]»", load_more: "عرض المزيد", clear_search: "مسح" } });
        } catch {
          document.getElementById("pagefind")!.textContent = "البحث يعمل بعد نشر الموقع.";
        }
      }
      (dlg.querySelector("input") as HTMLInputElement | null)?.focus();
    }
    document.getElementById("open-search")?.addEventListener("click", openSearch);
    dlg.querySelector("[data-close]")?.addEventListener("click", () => dlg.close());
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
    document.addEventListener("keydown", (e) => {
      if ((e.key === "/" || (e.key === "k" && (e.metaKey || e.ctrlKey))) && !dlg.open && !(e.target as HTMLElement).closest("input,textarea")) {
        e.preventDefault(); openSearch();
      }
    });
  </script>
  <script>
    // العدّادات الظاهرة (قراءات المقالات ومشاهدات الفيديو) عبر خدمة Abacus
    // تُحسب القراءة أو المشاهدة مرة واحدة لكل متصفح
    const API = "https://abacus.jasoncameron.dev";
    const NS = "almaljamie.my";
    const forms: Record<string, string[]> = {
      read: ["قراءة واحدة", "قراءتان", "قراءات", "قراءة"],
      watch: ["مشاهدة واحدة", "مشاهدتان", "مشاهدات", "مشاهدة"],
    };
    const word = (n: number, kind: string) => {
      const [one, two, few, many] = forms[kind] ?? forms.read;
      const f = n.toLocaleString("ar-u-nu-latn");
      if (n === 1) return one;
      if (n === 2) return two;
      const h = n % 100;
      return h >= 3 && h <= 10 ? `${f} ${few}` : `${f} ${many}`;
    };
    const show = (key: string, value: number) => {
      if (!value) return;
      document.querySelectorAll<HTMLElement>(`[data-stat="${key}"]`).forEach((el) => {
        el.querySelector("[data-stat-n]")!.textContent = word(value, el.dataset.kind ?? "read");
        el.classList.replace("hidden", "inline-flex");
      });
    };
    const firstTime = (key: string) => {
      try { if (localStorage.getItem(`stat:${key}`)) return false; localStorage.setItem(`stat:${key}`, "1"); return true; } catch { return false; }
    };
    const call = (op: string, key: string) =>
      fetch(`${API}/${op}/${NS}/${key}`, { keepalive: op === "hit" })
        .then((r) => (r.ok ? r.json() : null)).then((j) => j && show(key, j.value)).catch(() => {});
    (window as any).statHit = (key: string) => { if (firstTime(key)) call("hit", key); };
    const keys = new Map<string, boolean>();
    document.querySelectorAll<HTMLElement>("[data-stat]").forEach((el) => {
      keys.set(el.dataset.stat!, keys.get(el.dataset.stat!) || el.dataset.hit === "1");
    });
    keys.forEach((hit, key) => call(hit && firstTime(key) ? "hit" : "get", key));
  </script>
</body>
</html>
