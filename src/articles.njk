---
layout: base.njk
title: المقالات
permalink: /articles/
---
<section class="wrap page">
  <h1>المقالات</h1>
  <p class="lede">كل ما نُشر في المدونة، من الأحدث إلى الأقدم.</p>

  {% if collections.categories.length > 1 %}
  <nav class="chips" aria-label="التصنيفات">
    {% for c in collections.categories %}<a href="#cat-{{ loop.index }}">{{ c }}</a>{% endfor %}
  </nav>
  {% endif %}

  {% for c in collections.categories %}
  <section class="archive-group" id="cat-{{ loop.index }}">
    <h2>{{ c }}</h2>
    <ul class="archive">
      {% for p in collections.posts | byCategory(c) %}
      <li>
        <a href="{{ p.url }}">{{ p.data.title }}</a>
        <time datetime="{{ p.date | isoDate }}">{{ p.date | arDate }}</time>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</section>
