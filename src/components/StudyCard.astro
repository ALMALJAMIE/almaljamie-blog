---
import StudyCover from "./StudyCover.astro";
import DownloadButton from "./DownloadButton.astro";
import type { CollectionEntry } from "astro:content";
interface Props { study: CollectionEntry<"studies"> }
const { study } = Astro.props;
const d = study.data;
const meta = [d.journal, d.issue, d.year].filter(Boolean).join("، ");
const published = d.status === "published";
const href = `/studies/${study.id}/`;
const en = d.lang === "en";
---
<article class="group relative flex flex-col rounded-2xl bg-[var(--bg)] border border-[var(--rule)] overflow-hidden hover:border-indigo/40 hover:shadow-[0_12px_32px_-12px_rgba(19,41,75,.25)] transition">
  <div class="relative p-5 pb-0 bg-[var(--bg-2)]">
    <StudyCover id={study.id} title={d.title} type={d.type} year={d.year} image={d.cover}
      class="mx-auto w-[72%] aspect-[3/4] rounded-t-md shadow-[0_-2px_24px_-6px_rgba(0,0,0,.35)] group-hover:-translate-y-1 transition-transform duration-300" />
    <span class:list={["absolute top-4 start-4 text-[0.78rem] font-medium px-2.5 py-0.5 rounded-full",
      published ? "bg-glass-green text-white" : "bg-saffron text-ink"]}>{published ? d.type : "قيد الإنجاز"}</span>
    {en && <span class="absolute top-4 end-4 text-[0.75rem] font-medium px-2 py-0.5 rounded-full bg-indigo text-white">English</span>}
  </div>
  <div class="flex flex-col flex-1 p-6">
    <h3 class="text-[1.15rem] leading-[1.7]" dir={en ? "ltr" : undefined} lang={en ? "en" : undefined}>
      <a href={href} class="no-underline after:absolute after:inset-0 group-hover:text-indigo dark:group-hover:text-saffron">{d.title}</a>
    </h3>
    {meta && <p class="mt-1 text-[0.9rem] text-[var(--muted)]">{meta}</p>}
    <p class="mt-3 text-[0.97rem] leading-[1.9] text-[var(--muted)] line-clamp-3">{d.summary}</p>
    <div class="relative z-10 mt-auto pt-6 space-y-3" data-pagefind-ignore>
      <DownloadButton id={study.id} pdf={d.pdf} pages={d.pages} published={published} />
      <a href={href} class="flex items-center justify-center gap-2 py-2.5 rounded-xl border border-[var(--rule)] no-underline text-[0.95rem] font-medium hover:border-indigo hover:text-indigo dark:hover:text-saffron transition-colors">
        عرض ملخص الدراسة
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      </a>
    </div>
  </div>
</article>
