---
// غلاف مؤقت لعنصر الأرشيف إلى أن تُضاف صورته
interface Props { title: string; kind: string; year?: number; image?: string; class?: string }
const { title, kind, year, image, class: cls = "" } = Astro.props;
---
{image ? (
  <img src={image} alt={title} class={`object-cover ${cls}`} loading="lazy" />
) : (
  <div class={`relative overflow-hidden flex flex-col bg-[#efe8da] text-[#2a2118] ${cls}`} aria-hidden="true">
    <div class="h-2 bg-[#8e2b20]"></div>
    <div class="flex-1 flex flex-col p-5">
      <p class="text-[0.78rem] text-[#8e2b20] font-bold">{kind}{year ? ` · ${year}` : ""}</p>
      <p class="mt-3 text-[1.05rem] font-bold leading-[1.7] line-clamp-5">{title}</p>
      <div class="mt-auto space-y-1.5 opacity-40">
        <div class="h-1.5 rounded bg-[#2a2118] w-full"></div><div class="h-1.5 rounded bg-[#2a2118] w-5/6"></div><div class="h-1.5 rounded bg-[#2a2118] w-2/3"></div>
      </div>
    </div>
  </div>
)}
