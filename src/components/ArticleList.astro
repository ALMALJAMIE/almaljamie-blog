---
import PostItem from "./PostItem.astro";
import type { Post } from "../data/utils";
interface Props { posts: Post[]; current: number; last: number; categories: string[] }
const { posts, current, last, categories } = Astro.props;
const pageUrl = (n: number) => (n === 1 ? "/articles/" : `/articles/page/${n}/`);
---
<div class="mx-auto max-w-7xl px-5 sm:px-8 pt-10 grid lg:grid-cols-[1fr_18rem] gap-12">
  <div>
    {posts.map((p) => <PostItem post={p} />)}

    {last > 1 && (
      <nav class="mt-10 flex flex-wrap items-center justify-center gap-2" aria-label="صفحات المقالات">
        {current > 1 && <a href={pageUrl(current - 1)} class="px-4 h-10 grid place-items-center rounded-full border border-[var(--rule)] no-underline hover:border-indigo">السابق</a>}
        {Array.from({ length: last }, (_, i) => i + 1).map((n) => (
          n === current
            ? <span aria-current="page" class="w-10 h-10 grid place-items-center rounded-full bg-indigo text-white dark:bg-saffron dark:text-ink">{n}</span>
            : <a href={pageUrl(n)} class="w-10 h-10 grid place-items-center rounded-full border border-[var(--rule)] no-underline hover:border-indigo">{n}</a>
        ))}
        {current < last && <a href={pageUrl(current + 1)} class="px-4 h-10 grid place-items-center rounded-full border border-[var(--rule)] no-underline hover:border-indigo">التالي</a>}
      </nav>
    )}
  </div>

  <aside class="space-y-6">
    <div class="rounded-2xl border border-[var(--rule)] p-6">
      <h2 class="text-[1.1rem]">التصنيفات</h2>
      <ul class="mt-3 space-y-1">
        {categories.map((c) => <li class="flex items-center gap-2 text-[var(--muted)] before:w-1.5 before:h-1.5 before:rounded-full before:bg-saffron">{c}</li>)}
      </ul>
    </div>
    <div class="rounded-2xl bg-indigo text-white p-6 relative overflow-hidden">
      <div class="absolute inset-0 pattern"></div>
      <h2 class="relative text-[1.1rem]">الدراسات المنشورة</h2>
      <p class="relative mt-2 text-white/75 leading-[1.85]">دراساتي المحكّمة متاحة للتنزيل مجانًا بصيغة PDF.</p>
      <a href="/studies/" class="relative inline-block mt-4 px-5 py-2 rounded-full bg-saffron text-ink font-medium no-underline hover:bg-white">تصفّح الدراسات</a>
    </div>
  </aside>
</div>
