---
// غلاف مولّد للدراسة يشبه غلاف مجلة محكّمة: لون نيلي، قمرية صغيرة، والعنوان والنوع
import { seed } from "../data/utils";
interface Props { id: string; title: string; type: string; year?: number; image?: string; class?: string }
const { id, title, type, year, image, class: cls = "" } = Astro.props;
const tones = ["#13294b", "#1f3d36", "#3a2a4a", "#4a2f1f"];
const bg = tones[seed(id) % tones.length];
---
{image ? (
  <img src={image} alt={`غلاف: ${title}`} class={`object-cover ${cls}`} loading="lazy" />
) : (
  <div class={`relative overflow-hidden text-white flex flex-col ${cls}`} style={`background:${bg}`} aria-hidden="true">
    <div class="absolute inset-0 pattern opacity-80"></div>
    <div class="relative h-1.5 bg-saffron"></div>
    <div class="relative flex-1 flex flex-col p-5 sm:p-6">
      <p class="text-[0.78rem] text-white/70">{type}{year ? ` · ${year}` : ""}</p>
      <p class="mt-3 text-[1.08rem] sm:text-[1.15rem] font-bold leading-[1.7] line-clamp-5">{title}</p>
      <svg viewBox="0 0 80 52" class="mt-auto w-16 self-start opacity-90">
        <path d="M2 50V40a38 38 0 0 1 76 0v10z" fill="#fff" />
        <path d="M8 40a32 32 0 0 1 64 0z" fill="#c8962e" />
        <path d="M40 8v32M17.4 17.4 40 40M62.6 17.4 40 40" stroke="#fff" stroke-width="2.5" />
      </svg>
      <p class="mt-3 text-[0.78rem] text-white/70">أحمد عباس الملجمي</p>
    </div>
  </div>
)}
