---
interface Props { title: string; lead?: string; crumb?: string }
const { title, lead, crumb } = Astro.props;
---
<section class="relative bg-indigo text-white overflow-hidden">
  <div class="absolute inset-0 pattern"></div>
  <div class="relative mx-auto max-w-7xl px-5 sm:px-8 py-14 md:py-16">
    <nav aria-label="مسار الصفحة" class="text-[0.9rem] text-white/60">
      <a href="/" class="no-underline hover:text-white">الرئيسية</a>
      <span class="mx-2">/</span>
      <span class="text-white/90">{crumb ?? title}</span>
    </nav>
    <h1 class="mt-3 text-[2.3rem] sm:text-[3rem]">{title}</h1>
    {lead && <p class="mt-3 text-[1.1rem] text-white/75 max-w-2xl leading-[1.95]">{lead}</p>}
    <slot />
  </div>
</section>
