---
interface Props { url: string; title: string; label?: string }
const { url, title, label = "شارك المقال" } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const links = [
  { label: "واتساب", href: `https://wa.me/?text=${t}%20${u}`, d: "M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm4.6 12.6c-.2.6-1.1 1.1-1.6 1.2-.4.1-1 .1-1.6-.1-3-1-5-3.9-5.2-4.1-.1-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z" },
  { label: "فيسبوك", href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, d: "M14 8h2.5V4.5H14c-2.2 0-4 1.8-4 4V10H8v3.5h2V21h3.5v-7.5H16l.5-3.5h-3V8.5c0-.3.2-.5.5-.5z" },
  { label: "إكس", href: `https://x.com/intent/post?text=${t}&url=${u}`, d: "M4 4h4.5l3.7 5.2L16.6 4H20l-6.2 7.1L20.5 20H16l-4-5.6L7.1 20H3.7l6.7-7.7z" },
  { label: "تيليجرام", href: `https://t.me/share/url?url=${u}&text=${t}`, d: "M20.7 4.3 3.4 11c-1 .4-1 1.1-.2 1.4l4.4 1.4 1.7 5.2c.2.6.4.8.8.8s.6-.2.9-.5l2.1-2 4.4 3.2c.8.5 1.4.2 1.6-.8L21.9 5.6c.3-1.2-.4-1.7-1.2-1.3zM9 14.3l9-6.6-7.2 7.6-.3 3.2z" },
];
---
<div class="flex flex-wrap items-center gap-2 font-display">
  <span class="text-[var(--muted)] ms-0 me-1">{label}</span>
  {links.map((l) => (
    <a href={l.href} target="_blank" rel="noopener" aria-label={`شارك على ${l.label}`} title={l.label}
       class="w-10 h-10 grid place-items-center rounded-full border border-[var(--rule)] hover:border-[var(--fg)] hover:bg-[var(--bg-2)] transition-colors">
      <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="currentColor" aria-hidden="true"><path d={l.d} /></svg>
    </a>
  ))}
  <button type="button" data-copy={url}
     class="h-10 px-4 rounded-full border border-[var(--rule)] hover:border-[var(--fg)] hover:bg-[var(--bg-2)] transition-colors text-[0.95rem]">نسخ الرابط</button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
    b.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = "نُسخ الرابط"; }
      catch { b.textContent = "تعذّر النسخ"; }
      setTimeout(() => (b.textContent = "نسخ الرابط"), 2000);
    });
  });
</script>
