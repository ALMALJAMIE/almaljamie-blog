---
// زر تنزيل الدراسة مع عدّاد مرات التنزيل
interface Props { id: string; pdf?: string; pages?: number; published: boolean; label?: string }
const { id, pdf, pages, published, label = "تنزيل الدراسة" } = Astro.props;
---
{pdf ? (
  <div class="flex items-stretch gap-2">
    <a href={pdf} download data-dl={id} class="flex-1 flex items-center justify-center gap-2 py-3 rounded-xl bg-indigo text-white font-medium no-underline hover:bg-indigo-deep dark:bg-saffron dark:text-ink transition-colors">
      <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
      {label} (PDF){pages ? ` · ${pages} صفحة` : ""}
    </a>
    <span class="shrink-0 min-w-[5.5rem] flex flex-col items-center justify-center px-3 rounded-xl border border-[var(--rule)] leading-tight" title="عدد مرات التنزيل">
      <span data-count={id} class="text-[1.05rem] font-bold tabular-nums">…</span>
      <span class="text-[0.75rem] text-[var(--muted)]">تنزيل</span>
    </span>
  </div>
) : (
  <span class="flex items-center justify-center w-full py-3 rounded-xl border border-dashed border-[var(--rule)] text-[var(--muted)] text-[0.95rem]">
    {published ? "الملف يُضاف قريبًا" : "تُتاح للتنزيل بعد نشرها"}
  </span>
)}

<script>
  // عدّاد التنزيلات: خدمة Abacus المجانية. يُحسب التنزيل مرة واحدة لكل متصفح لكل دراسة
  const API = "https://abacus.jasoncameron.dev";
  const NS = "almaljamie.my";
  const key = (id: string) => `download-${id}`;
  const fmt = (n: number) => n.toLocaleString("ar-u-nu-latn");

  // آخر رقم معروف يُحفظ في المتصفح، فلا يظهر صفر خاطئ إذا تعثّرت الخدمة أو رفضت الطلب مؤقتًا
  const cacheKey = (id: string) => `dlc:${id}`;
  const show = (id: string, v: number) => {
    document.querySelectorAll<HTMLElement>(`[data-count="${id}"]`).forEach((el) => (el.textContent = fmt(v)));
    try { localStorage.setItem(cacheKey(id), String(v)); } catch {}
  };
  const load = async (id: string, tries = 3): Promise<void> => {
    try {
      const r = await fetch(`${API}/get/${NS}/${key(id)}`, { cache: "no-store" });
      if (r.ok) { const v = (await r.json()).value; if (typeof v === "number") return show(id, v); }
      else if (r.status === 404) return show(id, 0);   // لم يُنزَّل الملف بعد
    } catch {}
    if (tries > 1) { await new Promise((res) => setTimeout(res, 2500)); return load(id, tries - 1); }
  };
  const ids = new Set<string>();
  document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
    const id = el.dataset.count!;
    let cached: string | null = null;
    try { cached = localStorage.getItem(cacheKey(id)); } catch {}
    el.textContent = cached ? fmt(+cached) : "…";
    ids.add(id);
  });
  ids.forEach((id) => load(id));

  document.querySelectorAll<HTMLAnchorElement>("[data-dl]").forEach((a) => {
    a.addEventListener("click", () => {
      const id = a.dataset.dl!;
      const seen = `dl:${id}`;
      try { if (localStorage.getItem(seen)) return; localStorage.setItem(seen, "1"); } catch {}
      fetch(`${API}/hit/${NS}/${key(id)}`, { keepalive: true })
        .then((r) => r.json())
        .then((j) => typeof j.value === "number" && show(id, j.value))
        .catch(() => {});
    });
  });
</script>
