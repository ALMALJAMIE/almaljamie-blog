---
// الوثائق يمينًا والفيديو يسارًا على الحاسوب، وتحت بعض على الجوال
import { getCollection } from "astro:content";
import ArchiveCard from "./ArchiveCard.astro";
import VideoEmbed from "./VideoEmbed.astro";
import ViewCount from "./ViewCount.astro";
interface Props { limit?: number; class?: string }
const { limit, class: cls = "" } = Astro.props;
const all = await getCollection("infographics");
let docs = all.filter((i) => i.data.pdf).sort((a, b) => b.data.order - a.data.order || (b.data.year ?? 0) - (a.data.year ?? 0));
let videos = all.filter((i) => i.data.youtube).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
if (limit) { docs = docs.slice(0, limit); videos = videos.slice(0, limit); }
const docTitle = (id?: string) => all.find((i) => i.id === id);
---
  {(docs.length > 0 || videos.length > 0) && (
    <!-- على الحاسوب: الوثائق يمينًا والفيديو يسارًا في صف واحد، وعلى الجوال تحت بعض -->
    <section class:list={[cls, "grid gap-x-8 gap-y-14 items-start",
      docs.length && videos.length ? "lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]" : ""]}>
      {docs.length > 0 && (
        <div>
          <h2 class="text-[1.6rem]">الوثائق</h2>
          <div class:list={["mt-8 grid gap-6", videos.length ? "sm:grid-cols-2 lg:grid-cols-1" : "sm:grid-cols-2 lg:grid-cols-3"]}>
            {docs.map((i) => <ArchiveCard item={i} />)}
          </div>
        </div>
      )}
      {videos.length > 0 && (
        <div>
          <h2 class="text-[1.6rem]">الإنفوجرافيك</h2>
          <div class="mt-8 grid gap-6">
            {videos.map((v) => {
              const doc = docTitle(v.data.doc);
              return (
                <figure class="rounded-2xl border border-[var(--rule)] bg-[var(--bg)] overflow-hidden">
                  <VideoEmbed id={v.data.youtube!} title={v.data.title} poster={v.data.image} />
                  <figcaption class="p-5">
                    <p class="font-bold leading-[1.7]">{v.data.title}</p>
                    <p class="mt-1 text-[0.9rem] text-[var(--muted)] flex flex-wrap gap-x-4">
                      {v.data.duration && <span>{v.data.duration}</span>}
                      <ViewCount stat={`play-${v.data.youtube}`} kind="watch" />
                      {doc && <a href={`/infographics/${doc.id}/`} class="text-indigo dark:text-saffron">الوثيقة: تفاصيلها وتنزيلها</a>}
                    </p>
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </div>
      )}
    </section>
  )}

