---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { arDate } from "../data/utils";

const items = (await getCollection("infographics")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const withArticles = await Promise.all(
  items.map(async (i) => ({ ...i, post: i.data.article ? await getEntry("posts", i.data.article) : undefined }))
);
---
<Base title="أرشيف الإنفوجرافيك" description="أرشيف الإنفوجرافيك والصور التوضيحية التي أعدها الباحث أحمد عباس الملجمي.">
  <PageHead title="أرشيف الإنفوجرافيك" lead="تصاميم توضيحية رافقت المقالات والدراسات. اضغط على أي تصميم لعرضه بحجم كامل أو تنزيله." />

  <section class="mx-auto max-w-7xl px-5 sm:px-8 pt-12">
    {withArticles.length ? (
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 [column-fill:_balance]">
        {withArticles.map((i, n) => (
          <figure class="mb-6 break-inside-avoid rounded-2xl border border-[var(--rule)] bg-[var(--bg)] overflow-hidden">
            <button type="button" class="block w-full cursor-zoom-in" data-open={n} aria-label={`عرض: ${i.data.title}`}>
              <img src={i.data.image} alt={i.data.title} loading="lazy" class="w-full h-auto" />
            </button>
            <figcaption class="p-5">
              <p class="font-bold leading-[1.7]">{i.data.title}</p>
              <p class="mt-1 text-[0.9rem] text-[var(--muted)] flex flex-wrap gap-x-4">
                <time datetime={i.data.date.toISOString()}>{arDate(i.data.date)}</time>
                {i.post && <a href={`/articles/${i.post.id}/`} class="text-indigo dark:text-saffron">من مقال: {i.post.data.title}</a>}
              </p>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p class="text-[var(--muted)]">يُضاف أول تصميم قريبًا.</p>
    )}
  </section>

  <!-- العرض بحجم كامل -->
  <dialog id="viewer" class="m-auto w-[min(1100px,96vw)] max-h-[94vh] rounded-2xl p-0 bg-[var(--bg)] text-[var(--fg)] backdrop:bg-black/80">
    <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-[var(--rule)]">
      <p id="v-title" class="font-bold truncate"></p>
      <div class="flex items-center gap-1 shrink-0">
        <a id="v-download" download class="px-4 py-2 rounded-full bg-indigo text-white text-[0.9rem] no-underline dark:bg-saffron dark:text-ink">تنزيل الصورة</a>
        <button type="button" id="v-prev" class="w-9 h-9 grid place-items-center rounded-full hover:bg-[var(--bg-2)]" aria-label="السابق">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <button type="button" id="v-next" class="w-9 h-9 grid place-items-center rounded-full hover:bg-[var(--bg-2)]" aria-label="التالي">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 6l-6 6 6 6"/></svg>
        </button>
        <button type="button" id="v-close" class="w-9 h-9 grid place-items-center rounded-full hover:bg-[var(--bg-2)]" aria-label="إغلاق">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
    </div>
    <img id="v-img" alt="" class="block mx-auto max-h-[calc(94vh-4rem)] w-auto max-w-full object-contain bg-[var(--bg-2)]" />
  </dialog>

  <script define:vars={{ list: withArticles.map((i) => ({ src: i.data.image, title: i.data.title })) }}>
    const dlg = document.getElementById("viewer");
    const img = document.getElementById("v-img");
    const title = document.getElementById("v-title");
    const dl = document.getElementById("v-download");
    let cur = 0;
    const show = (n) => {
      cur = (n + list.length) % list.length;
      img.src = list[cur].src; img.alt = list[cur].title;
      title.textContent = list[cur].title; dl.href = list[cur].src;
    };
    document.querySelectorAll("[data-open]").forEach((b) => b.addEventListener("click", () => { show(+b.dataset.open); dlg.showModal(); }));
    document.getElementById("v-close").addEventListener("click", () => dlg.close());
    document.getElementById("v-next").addEventListener("click", () => show(cur + 1));
    document.getElementById("v-prev").addEventListener("click", () => show(cur - 1));
    dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
    document.addEventListener("keydown", (e) => {
      if (!dlg.open) return;
      if (e.key === "ArrowLeft") show(cur + 1);
      if (e.key === "ArrowRight") show(cur - 1);
    });
  </script>
</Base>
