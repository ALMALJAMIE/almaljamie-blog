---
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/PageHead.astro";
import ArticleList from "../../../components/ArticleList.astro";
import { getPosts, type Post } from "../../../data/utils";

const PER_PAGE = 8;
export async function getStaticPaths() {
  const PER_PAGE = 8;
  const posts = await getPosts();
  const last = Math.ceil(posts.length / PER_PAGE);
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => i + 2).map((n) => ({
    params: { page: String(n) },
    props: { posts: posts.slice((n - 1) * PER_PAGE, n * PER_PAGE), current: n, last, categories, total: posts.length },
  }));
}
interface Props { posts: Post[]; current: number; last: number; categories: string[]; total: number }
const { posts, current, last, categories, total } = Astro.props;
---
<Base title={`المقالات، الصفحة ${current}`}>
  <PageHead title="المقالات" crumb={`المقالات، الصفحة ${current}`} lead={`${total} مقالات في الشأن اليمني، من الأحدث إلى الأقدم.`} />
  <ArticleList posts={posts} current={current} last={last} categories={categories} />
</Base>
