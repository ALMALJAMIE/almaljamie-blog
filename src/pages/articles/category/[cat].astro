---
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/PageHead.astro";
import ArticleList from "../../../components/ArticleList.astro";
import { getPosts, tagSlug, arCount, type Post } from "../../../data/utils";

// صفحة لكل تصنيف تعرض مقالاته
export async function getStaticPaths() {
  const posts = await getPosts();
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((c) => ({ params: { cat: tagSlug(c) }, props: { cat: c, list: posts.filter((p) => p.data.category === c) } }));
}
interface Props { cat: string; list: Post[] }
const { cat, list } = Astro.props;
---
<Base title={`مقالات ${cat}`} description={`مقالات أحمد عباس الملجمي في تصنيف ${cat}.`}>
  <PageHead title={cat} crumb={`المقالات / ${cat}`} lead={`${arCount(list.length, "مقال واحد", "مقالان", "مقالات", "مقالًا")} في هذا التصنيف، من الأحدث إلى الأقدم.`} />
  <ArticleList posts={list} current={1} last={1} categories={[]} active={cat} />
</Base>
