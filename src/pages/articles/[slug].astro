---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import Share from "../../components/Share.astro";
import PostItem from "../../components/PostItem.astro";
import ViewCount from "../../components/ViewCount.astro";
import Subscribe from "../../components/Subscribe.astro";
import ListenPlayer from "../../components/ListenPlayer.astro";
import { getPosts, arDate, readingTime, tagUrl, catUrl, type Post } from "../../data/utils";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts } }));
}
interface Props { post: Post; newer?: Post; older?: Post; all: Post[] }
const { post, newer, older, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const toc = headings.filter((h) => h.depth === 2);
const url = new URL(`/articles/${post.id}/`, site.url).href;
// السلسلة: مقالاتها مرتبة من الأقدم إلى الأحدث
const series = d.series ? all.filter((p) => p.data.series === d.series).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf()) : [];
const sIdx = series.findIndex((p) => p.id === post.id);
const sPrev = sIdx > 0 ? series[sIdx - 1] : undefined;
const sNext = sIdx >= 0 && sIdx < series.length - 1 ? series[sIdx + 1] : undefined;
const latest = all.filter((p) => p.id !== post.id).slice(0, 5);
const words = (post.body || "").split(/\s+/).filter(Boolean).length;
const related = all.filter((p) => p.id !== post.id && p.data.category === d.category && !(d.series && p.data.series === d.series)).slice(0, 3);
---
<Base title={d.title} description={d.summary} type="article" image={d.cover} keywords={d.tags}>
  <div id="progress" class="fixed top-0 inset-x-0 h-[3px] bg-saffron z-50" aria-hidden="true"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8 pt-10 md:pt-14 grid lg:grid-cols-[minmax(0,1fr)_19rem] gap-x-14">
  <article data-pagefind-body class="min-w-0">
    <header>
      <a href={catUrl(d.category)} class="font-display text-glass-green dark:text-[#7cc4a9] no-underline" data-pagefind-filter="التصنيف">{d.category}</a>
      <h1 class="mt-2 font-display font-bold text-[2rem] sm:text-[2.6rem] leading-[1.45] text-balance">{d.title}</h1>
      {d.summary && <p class="mt-4 text-[1.2rem] leading-[1.95] text-[var(--muted)] max-w-3xl text-pretty">{d.summary}</p>}
      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.98rem] text-[var(--muted)]">
        <a href="/cv/" class="font-medium text-[var(--fg)] no-underline hover:text-indigo dark:hover:text-saffron">{site.title}</a>
        <time datetime={d.date.toISOString()}>{arDate(d.date)}</time>
        <span>{readingTime(post.body)}</span>
        <ViewCount stat={`view-${post.id}`} hit />
      </div>
      {d.source && (
        <p class="mt-1.5 text-[0.98rem] text-[var(--muted)]">
          نُشر أيضًا في {d.sourceUrl ? <a href={d.sourceUrl} class="text-glass-blue dark:text-[#8fb4e8]">{d.source}</a> : d.source}
        </p>
      )}
    </header>

    <!-- أدوات القراءة: الاستماع وحجم الخط -->
    <div class="mt-6 pt-5 border-t border-[var(--rule)] flex flex-wrap items-center gap-3 print:hidden" data-pagefind-ignore>
      <ListenPlayer words={words} />
      <div class="flex items-center gap-1 rounded-full bg-[var(--bg-2)] border border-[var(--rule)] p-1 h-14" role="group" aria-label="حجم خط القراءة">
        <button type="button" id="font-down" class="w-11 h-11 grid place-items-center rounded-full hover:bg-[var(--bg)] disabled:opacity-35 disabled:cursor-not-allowed" aria-label="تصغير الخط" title="تصغير الخط">
          <span class="font-[family-name:var(--font-read)] text-[0.95rem] leading-none">ع</span>
        </button>
        <span id="font-level" class="min-w-[3.2rem] text-center text-[0.85rem] text-[var(--muted)] tabular-nums cursor-pointer" title="الحجم الأصلي" aria-live="polite">100%</span>
        <button type="button" id="font-up" class="w-11 h-11 grid place-items-center rounded-full hover:bg-[var(--bg)] disabled:opacity-35 disabled:cursor-not-allowed" aria-label="تكبير الخط" title="تكبير الخط">
          <span class="font-[family-name:var(--font-read)] text-[1.6rem] leading-none">ع</span>
        </button>
      </div>
    </div>

    <figure class="mt-6" data-pagefind-ignore>
      {d.cover
        ? <img src={d.cover} alt={d.title} class="w-full h-auto max-h-[26rem] object-contain rounded-xl bg-[var(--bg-2)]" />
        : <Cover id={post.id} category={d.category} alt={d.title} class="w-full aspect-[21/8] rounded-xl" />}
    </figure>

      <div class="article prose min-w-0 mt-10 max-w-[44rem]">
        {series.length > 1 && (
          <details class="not-prose mb-10 rounded-2xl border border-[var(--rule)] bg-[var(--bg-2)] font-[family-name:var(--font-display)] text-[1rem]" data-pagefind-ignore>
            <summary class="cursor-pointer list-none flex items-center justify-between gap-3 p-5">
              <span><span class="text-[var(--muted)]">سلسلة: </span><strong>{d.series}</strong></span>
              <span class="text-[0.9rem] text-[var(--muted)]">المقال {sIdx + 1} من {series.length}</span>
            </summary>
            <ol class="px-5 pb-5 space-y-1">
              {series.map((p, i) => (
                <li class="flex gap-3 items-baseline">
                  <span class:list={["shrink-0 w-6 h-6 grid place-items-center rounded-full text-[0.8rem]", i === sIdx ? "bg-indigo text-white dark:bg-saffron dark:text-ink" : "bg-[var(--bg)] text-[var(--muted)] border border-[var(--rule)]"]}>{i + 1}</span>
                  {i === sIdx
                    ? <span class="font-bold">{p.data.title}</span>
                    : <a href={`/articles/${p.id}/`} class="no-underline hover:text-indigo dark:hover:text-saffron">{p.data.title}</a>}
                </li>
              ))}
            </ol>
          </details>
        )}
        <Content />
      </div>

    <footer class="max-w-[44rem] mt-14" data-pagefind-ignore>
      {d.tags.length > 0 && (
        <div class="mb-8 flex flex-wrap items-center gap-2">
          <span class="text-[var(--muted)] me-1">كلمات مفتاحية:</span>
          {d.tags.map((t) => <a href={tagUrl(t)} class="no-underline text-[0.92rem] px-3 py-1 rounded-full bg-[var(--bg-2)] border border-[var(--rule)] hover:border-indigo hover:text-indigo dark:hover:text-saffron">{t}</a>)}
        </div>
      )}
      <Share url={url} title={d.title} />
      <Subscribe class="mt-10" />
      <div class="mt-10 flex gap-5 items-center rounded-xl bg-[var(--bg-2)] p-6">
        <img src="/images/author.jpg" alt="" width="72" height="72" class="w-[72px] h-[72px] rounded-full object-cover shrink-0"
             onerror="this.outerHTML='<span class=&quot;w-[72px] h-[72px] rounded-full bg-indigo text-plaster grid place-items-center font-display text-3xl shrink-0&quot;>أ</span>'" />
        <div>
          <p class="font-display text-lg font-bold">{site.title}</p>
          <p class="text-[1.02rem] leading-[1.9] text-[var(--muted)]">باحث يمني في علم الاجتماع السياسي، يكتب عن المجتمع اليمني وتحولاته.</p>
          <a href="/cv/" class="font-display text-[0.95rem] text-glass-blue dark:text-[#8fb4e8]">السيرة الذاتية</a>
        </div>
      </div>

      {series.length > 1 && (
        <nav class="mt-10 grid sm:grid-cols-2 gap-4" aria-label={`مقالات سلسلة ${d.series}`}>
          {sPrev ? (
            <a href={`/articles/${sPrev.id}/`} class="no-underline rounded-xl border border-[var(--rule)] hover:border-indigo p-5 transition-colors">
              <span class="block text-sm text-[var(--muted)]">الجزء السابق من السلسلة</span>
              <span class="block mt-1 text-[1.1rem] leading-relaxed">{sPrev.data.title}</span>
            </a>
          ) : <span class="hidden sm:block"></span>}
          {sNext && (
            <a href={`/articles/${sNext.id}/`} class="no-underline rounded-xl bg-indigo text-white dark:bg-saffron dark:text-ink p-5 sm:text-left">
              <span class="block text-sm opacity-75">الجزء التالي من السلسلة</span>
              <span class="block mt-1 text-[1.1rem] leading-relaxed">{sNext.data.title}</span>
            </a>
          )}
        </nav>
      )}
      <nav class="mt-10 grid sm:grid-cols-2 gap-4 font-display" aria-label="مقالات أخرى">
        {newer ? (
          <a href={`/articles/${newer.id}/`} class="no-underline rounded-xl border border-[var(--rule)] hover:border-[var(--fg)] p-5 transition-colors">
            <span class="block text-sm text-[var(--muted)]">المقال الأحدث</span>
            <span class="block mt-1 text-[1.1rem] leading-relaxed">{newer.data.title}</span>
          </a>
        ) : <span class="hidden sm:block"></span>}
        {older && (
          <a href={`/articles/${older.id}/`} class="no-underline rounded-xl border border-[var(--rule)] hover:border-[var(--fg)] p-5 transition-colors sm:text-left">
            <span class="block text-sm text-[var(--muted)]">المقال الأقدم</span>
            <span class="block mt-1 text-[1.1rem] leading-relaxed">{older.data.title}</span>
          </a>
        )}
      </nav>
    </footer>
  </article>

  <!-- العمود الجانبي -->
  <aside class="hidden lg:block" data-pagefind-ignore>
    <div class="sticky top-28 space-y-8">
      <div class="rounded-2xl border border-[var(--rule)] p-5 flex gap-4 items-center">
        <img src="/images/author.jpg" alt="" width="56" height="56" class="w-14 h-14 rounded-full object-cover shrink-0" />
        <div class="min-w-0">
          <a href="/cv/" class="font-display font-bold no-underline hover:text-indigo dark:hover:text-saffron">{site.title}</a>
          <p class="text-[0.88rem] text-[var(--muted)] leading-relaxed">باحث في علم الاجتماع السياسي</p>
        </div>
      </div>
      {toc.length > 1 && (
        <nav class="font-display text-[0.95rem]" aria-label="محتويات المقال">
          <p class="font-bold mb-3">في هذا المقال</p>
          <ol class="space-y-2 border-s-2 border-[var(--rule)]">
            {toc.map((h) => (
              <li><a href={`#${h.slug}`} data-toc={h.slug} class="block -ms-[2px] ps-4 border-s-2 border-transparent no-underline text-[var(--muted)] hover:text-[var(--fg)] leading-relaxed">{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}
      <div>
        <p class="font-display font-bold pb-2 border-b-2 border-[var(--fg)]">أحدث المقالات</p>
        <ul class="divide-y divide-[var(--rule)]">
          {latest.map((p) => (
            <li class="py-3">
              <a href={`/articles/${p.id}/`} class="block font-display font-medium leading-[1.7] no-underline hover:text-indigo dark:hover:text-saffron">{p.data.title}</a>
              <span class="text-[0.82rem] text-[var(--muted)]">{arDate(p.data.date)}</span>
            </li>
          ))}
        </ul>
        <a href="/articles/" class="mt-3 inline-block text-[0.9rem] font-medium text-indigo dark:text-saffron">كل المقالات</a>
      </div>
    </div>
  </aside>
  </div>

  {related.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 sm:px-8 mt-20" data-pagefind-ignore>
      <h2 class="font-display text-2xl font-bold border-b-2 border-[var(--fg)] pb-3">من التصنيف نفسه</h2>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
        {related.map((p) => <PostItem post={p} variant="card" />)}
      </div>
    </section>
  )}

  <script>
    // حجم خط القراءة: من 80% إلى 170% بخطوة 10% لكل نقرة، ويُحفظ لزيارات القارئ القادمة
    const art = document.querySelector(".article") as HTMLElement;
    const base = parseFloat(getComputedStyle(art).fontSize);
    const MIN = 0.8, MAX = 1.7, STEP = 0.1;
    let scale = 1;
    try { scale = Math.min(MAX, Math.max(MIN, parseFloat(localStorage.getItem("fontScale") || "1") || 1)); } catch {}
    const down = document.getElementById("font-down") as HTMLButtonElement;
    const up = document.getElementById("font-up") as HTMLButtonElement;
    const level = document.getElementById("font-level")!;
    const apply = () => {
      art.style.fontSize = `${(base * scale).toFixed(2)}px`;
      level.textContent = `${Math.round(scale * 100)}%`;
      down.disabled = scale <= MIN + 0.001;
      up.disabled = scale >= MAX - 0.001;
      try { localStorage.setItem("fontScale", String(scale)); } catch {}
    };
    down.addEventListener("click", () => { scale = Math.max(MIN, +(scale - STEP).toFixed(2)); apply(); });
    up.addEventListener("click", () => { scale = Math.min(MAX, +(scale + STEP).toFixed(2)); apply(); });
    level.addEventListener("click", () => { scale = 1; apply(); });
    apply();

    const bar = document.getElementById("progress")!;
    const article = document.querySelector(".article") as HTMLElement;
    const onScroll = () => {
      const r = article.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc]");
    if (links.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((l) => {
            const on = l.dataset.toc === e.target.id;
            l.classList.toggle("text-[var(--fg)]", on);
            l.classList.toggle("border-saffron", on);
          });
        });
      }, { rootMargin: "-20% 0px -70% 0px" });
      document.querySelectorAll(".article h2[id]").forEach((h) => io.observe(h));
    }
  </script>
</Base>
