---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import Share from "../../components/Share.astro";
import PostItem from "../../components/PostItem.astro";
import { getPosts, arDate, readingTime, type Post } from "../../data/utils";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts } }));
}
interface Props { post: Post; newer?: Post; older?: Post; all: Post[] }
const { post, newer, older, all } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const toc = headings.filter((h) => h.depth === 2);
const url = new URL(`/articles/${post.id}/`, site.url).href;
const related = all.filter((p) => p.id !== post.id && p.data.category === d.category).slice(0, 3);
---
<Base title={d.title} description={d.summary} type="article" image={d.cover}>
  <div id="progress" class="fixed top-0 inset-x-0 h-[3px] bg-saffron z-50" aria-hidden="true"></div>

  <article data-pagefind-body>
    <header class="mx-auto max-w-4xl px-5 sm:px-8 pt-12 md:pt-16 text-center">
      <a href="/articles/" class="font-display text-glass-green dark:text-[#7cc4a9] no-underline" data-pagefind-filter="التصنيف">{d.category}</a>
      <h1 class="mt-3 font-display font-bold text-[2.2rem] sm:text-5xl leading-[1.4] text-balance">{d.title}</h1>
      {d.summary && <p class="mt-5 text-[1.25rem] leading-[2] text-[var(--muted)] max-w-2xl mx-auto text-pretty">{d.summary}</p>}
      <div class="mt-6 flex flex-wrap justify-center items-center gap-x-5 gap-y-1 text-[1rem] text-[var(--muted)]">
        <span>{site.title}</span>
        <time datetime={d.date.toISOString()}>{arDate(d.date)}</time>
        <span>{readingTime(post.body)}</span>
      </div>
      {d.source && (
        <p class="mt-2 text-[1rem] text-[var(--muted)]">
          نُشر أيضًا في {d.sourceUrl ? <a href={d.sourceUrl} class="text-glass-blue dark:text-[#8fb4e8]">{d.source}</a> : d.source}
        </p>
      )}
    </header>

    <div class="mx-auto max-w-5xl px-5 sm:px-8 mt-10" data-pagefind-ignore>
      {d.cover
        ? <img src={d.cover} alt={d.title} class="w-full h-auto max-h-[80vh] object-contain rounded-xl bg-[var(--bg-2)]" />
        : <Cover id={post.id} category={d.category} alt={d.title} class="w-full aspect-[21/9] rounded-xl" />}
    </div>

    <div class="mx-auto max-w-6xl px-5 sm:px-8 mt-12 grid lg:grid-cols-[1fr_38rem_1fr] gap-10">
      <aside class="hidden lg:block" data-pagefind-ignore>
        {toc.length > 1 && (
          <nav class="sticky top-28 font-display text-[0.95rem]" aria-label="محتويات المقال">
            <p class="text-[var(--muted)] mb-3">في هذا المقال</p>
            <ol class="space-y-2 border-s-2 border-[var(--rule)]">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`} data-toc={h.slug} class="block -ms-[2px] ps-4 border-s-2 border-transparent no-underline text-[var(--muted)] hover:text-[var(--fg)] leading-relaxed">{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
      </aside>
      <div class="article prose min-w-0">
        <Content />
      </div>
      <div></div>
    </div>

    <footer class="mx-auto max-w-[38rem] px-5 sm:px-0 mt-14" data-pagefind-ignore>
      <Share url={url} title={d.title} />
      <div class="mt-10 flex gap-5 items-center rounded-xl bg-[var(--bg-2)] p-6">
        <img src="/images/author.jpg" alt="" width="72" height="72" class="w-[72px] h-[72px] rounded-full object-cover shrink-0"
             onerror="this.outerHTML='<span class=&quot;w-[72px] h-[72px] rounded-full bg-indigo text-plaster grid place-items-center font-display text-3xl shrink-0&quot;>أ</span>'" />
        <div>
          <p class="font-display text-lg font-bold">{site.title}</p>
          <p class="text-[1.02rem] leading-[1.9] text-[var(--muted)]">باحث يمني في علم الاجتماع والأنثروبولوجيا، يكتب عن المجتمع اليمني وتحولاته.</p>
          <a href="/about/" class="font-display text-[0.95rem] text-glass-blue dark:text-[#8fb4e8]">عن الكاتب</a>
        </div>
      </div>

      <nav class="mt-10 grid sm:grid-cols-2 gap-4 font-display" aria-label="مقالات أخرى">
        {newer ? (
          <a href={`/articles/${newer.id}/`} class="no-underline rounded-xl border border-[var(--rule)] hover:border-[var(--fg)] p-5 transition-colors">
            <span class="block text-sm text-[var(--muted)]">المقال الأحدث</span>
            <span class="block mt-1 text-[1.1rem] leading-relaxed">{newer.data.title}</span>
          </a>
        ) : <span class="hidden sm:block"></span>}
        {older && (
          <a href={`/articles/${older.id}/`} class="no-underline rounded-xl border border-[var(--rule)] hover:border-[var(--fg)] p-5 transition-colors sm:text-left">
            <span class="block text-sm text-[var(--muted)]">المقال الأقدم</span>
            <span class="block mt-1 text-[1.1rem] leading-relaxed">{older.data.title}</span>
          </a>
        )}
      </nav>
    </footer>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-6xl px-5 sm:px-8 mt-20" data-pagefind-ignore>
      <h2 class="font-display text-2xl font-bold border-b-2 border-[var(--fg)] pb-3">من التصنيف نفسه</h2>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-10">
        {related.map((p) => <PostItem post={p} variant="card" />)}
      </div>
    </section>
  )}

  <script>
    const bar = document.getElementById("progress")!;
    const article = document.querySelector(".article") as HTMLElement;
    const onScroll = () => {
      const r = article.getBoundingClientRect();
      const total = r.height - innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc]");
    if (links.length) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((l) => {
            const on = l.dataset.toc === e.target.id;
            l.classList.toggle("text-[var(--fg)]", on);
            l.classList.toggle("border-saffron", on);
          });
        });
      }, { rootMargin: "-20% 0px -70% 0px" });
      document.querySelectorAll(".article h2[id]").forEach((h) => io.observe(h));
    }
  </script>
</Base>
