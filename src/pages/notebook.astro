---
// مفكرة الباحث الذكية: تعمل كلها في متصفح المستخدم، والبيانات محفوظة فيه (IndexedDB)
// المنطق في src/scripts/notebook.ts
import Base from "../layouts/Base.astro";
const field = "mt-1.5 w-full rounded-xl border border-[var(--rule)] bg-[var(--bg)] px-3 py-2.5 focus:outline-none focus:border-indigo dark:focus:border-saffron";
const label = "block text-[0.9rem] font-medium";
---
<Base title="مفكرة الباحث الذكية" description="مفكرة مجانية للباحث: احفظ المقتبسات والأفكار والصور والمراجع في مشاريع، واحصل على التوثيق وقائمة المراجع بنمط APA جاهزة.">
  <section class="relative bg-indigo text-white overflow-hidden">
    <div class="absolute inset-0 pattern"></div>
    <div class="absolute -bottom-32 -start-32 w-[26rem] h-[26rem] rounded-full bg-saffron/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[90rem] px-4 sm:px-6 py-9 md:py-11 flex flex-wrap items-end justify-between gap-6">
      <div class="min-w-0">
        <p class="text-saffron font-medium" id="nb-kicker">مفكرة الباحث الذكية</p>
        <h1 class="mt-2 text-[1.8rem] sm:text-[2.3rem] leading-[1.35]" id="nb-title">كل الأرشيف</h1>
        <p class="mt-2 text-white/70" id="nb-stats">&nbsp;</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <button type="button" id="nb-bib" class="px-5 py-3 rounded-full border border-white/30 hover:bg-white/10 font-medium">قائمة المراجع APA</button>
        <button type="button" id="nb-add" class="px-6 py-3 rounded-full bg-saffron text-ink font-bold hover:bg-white transition-colors">+ إضافة</button>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-[90rem] px-4 sm:px-6 pt-8 grid lg:grid-cols-[16rem_minmax(0,1fr)] gap-6" data-pagefind-ignore>
    <aside class="hidden lg:block">
      <div class="sticky top-28 space-y-7">
        <div>
          <div class="flex items-center justify-between">
            <h2 class="text-[1rem] font-bold">مشاريعي</h2>
            <button type="button" id="nb-new-project" class="text-[0.88rem] text-indigo dark:text-saffron font-medium">+ مشروع</button>
          </div>
          <ul class="mt-3 space-y-0.5" id="nb-projects"></ul>
        </div>
        <div id="nb-tags-wrap" hidden>
          <h2 class="text-[1rem] font-bold">الوسوم</h2>
          <div class="mt-3 flex flex-wrap gap-1.5" id="nb-tags"></div>
        </div>
        <div class="rounded-xl border border-[var(--rule)] p-4 text-[0.85rem] text-[var(--muted)] leading-[1.8] space-y-3">
          <p id="nb-usage">&nbsp;</p>
          <p>تُحفظ مفكرتك في هذا المتصفح فقط. صدّر نسخة احتياطية بين حين وآخر.</p>
          <div class="flex gap-2">
            <button type="button" id="nb-export" class="flex-1 py-2 rounded-lg bg-[var(--bg-2)] text-[var(--fg)] font-medium hover:text-indigo">تصدير</button>
            <label class="flex-1 py-2 rounded-lg bg-[var(--bg-2)] text-[var(--fg)] font-medium text-center cursor-pointer hover:text-indigo">استيراد<input type="file" id="nb-import" accept="application/json,.json" class="sr-only" /></label>
          </div>
        </div>
      </div>
    </aside>

    <div class="min-w-0">
      <!-- على الجوال: اختيار المشروع -->
      <div class="lg:hidden flex gap-2 mb-3">
        <select id="nb-project-select" class={`${field} mt-0 flex-1`} aria-label="المشروع"></select>
        <button type="button" id="nb-more" class="px-4 rounded-xl border border-[var(--rule)]" aria-label="خيارات">⋯</button>
      </div>
      <div class="flex flex-col md:flex-row gap-3 md:items-center">
        <label class="relative flex-1">
          <span class="sr-only">بحث</span>
          <svg viewBox="0 0 24 24" class="absolute top-1/2 -translate-y-1/2 start-3.5 w-5 h-5 text-[var(--muted)]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="nb-search" type="search" placeholder="ابحث في النصوص والكتب والمؤلفين والوسوم…" class="w-full ps-11 pe-4 py-3 rounded-xl border border-[var(--rule)] bg-[var(--bg)] focus:outline-none focus:border-indigo dark:focus:border-saffron" />
        </label>
        <div class="flex gap-1.5 overflow-x-auto pb-1 md:pb-0" id="nb-types" role="group" aria-label="تصفية حسب النوع"></div>
      </div>
      <p id="nb-active-tag" class="mt-3 text-[0.92rem]" hidden></p>
      <div id="nb-list" class="mt-6 columns-1 md:columns-2 2xl:columns-3 gap-5 [&>*]:mb-5 [&>*]:break-inside-avoid"></div>
      <div id="nb-empty" class="mt-6" hidden></div>
    </div>
  </div>

  <!-- نافذة الإضافة والتعديل -->
  <div id="nb-drawer" hidden class="fixed inset-0 z-50 bg-black/40 flex" data-pagefind-ignore>
    <form id="nb-form" class="w-full max-w-[30rem] h-full bg-[var(--bg)] shadow-2xl overflow-y-auto p-6 me-auto" novalidate>
      <div class="flex items-center justify-between">
        <h2 class="text-[1.3rem]" id="nb-form-title">إضافة إلى الأرشيف</h2>
        <button type="button" data-close class="w-9 h-9 rounded-full hover:bg-[var(--bg-2)] text-2xl leading-none" aria-label="إغلاق">×</button>
      </div>
      <div class="mt-5 grid grid-cols-5 gap-1 p-1 rounded-xl bg-[var(--bg-2)] text-[0.88rem]" id="nb-form-types" role="tablist"></div>

      <div data-show="quote note image pdf" class="mt-5">
        <label class={label} for="f-text" id="f-text-label">النص المقتبس</label>
        <textarea id="f-text" rows="5" class={`${field} font-read text-[1.1rem] leading-[1.9]`}></textarea>
      </div>

      <div data-show="image pdf" class="mt-4">
        <label class={label}>الملف</label>
        <label id="f-drop" class="mt-1.5 flex flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-[var(--rule)] p-5 text-center text-[var(--muted)] cursor-pointer hover:border-indigo">
          <span id="f-file-name">اسحب الملف هنا أو اضغط للاختيار</span>
          <span class="text-[0.82rem]" data-show="image">ويمكنك لصق صورة من الحافظة مباشرة</span>
          <input type="file" id="f-file" class="sr-only" />
        </label>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3">
        <div class="col-span-2" data-show="quote image pdf ref">
          <label class={label} for="f-source" id="f-source-label">الكتاب أو المصدر</label>
          <input id="f-source" list="dl-sources" class={field} autocomplete="off" />
        </div>
        <div data-show="quote ref" class="col-span-2 sm:col-span-1">
          <label class={label} for="f-author">المؤلف</label>
          <input id="f-author" list="dl-authors" class={field} autocomplete="off" />
        </div>
        <div data-show="quote ref" class="col-span-2 sm:col-span-1 grid grid-cols-2 gap-2">
          <div><label class={label} for="f-year">السنة</label><input id="f-year" inputmode="numeric" class={field} /></div>
          <div data-show="quote"><label class={label} for="f-page">الصفحة</label><input id="f-page" class={field} /></div>
        </div>
        <div data-show="image pdf" class="col-span-2 sm:col-span-1">
          <label class={label} for="f-page2">الصفحة</label><input id="f-page2" class={field} />
        </div>
        <div data-show="ref" class="col-span-2">
          <label class={label} for="f-publisher">الناشر</label><input id="f-publisher" list="dl-publishers" class={field} autocomplete="off" />
        </div>
        <div data-show="ref" class="col-span-2">
          <label class={label} for="f-url">الرابط</label><input id="f-url" type="url" dir="ltr" class={field} placeholder="https://" />
        </div>
      </div>
      <p data-show="quote ref" class="mt-2 text-[0.85rem] text-[var(--muted)]">المؤلف والكتاب يُكمَلان من مصادرك السابقة.</p>
      <div data-show="quote ref" class="mt-3 rounded-lg bg-[var(--bg-2)] px-3 py-2 text-[0.9rem]" id="f-preview"></div>

      <label class={`${label} mt-4`} for="f-project">المشروع</label>
      <select id="f-project" class={field}></select>
      <label class={`${label} mt-4`} for="f-tags">الوسوم</label>
      <input id="f-tags" class={field} placeholder="#العرف #القبيلة" autocomplete="off" />

      <p id="f-error" class="mt-4 text-glass-red text-[0.92rem]" hidden></p>
      <button type="submit" class="mt-6 w-full py-3.5 rounded-xl bg-indigo text-white font-bold dark:bg-saffron dark:text-ink">حفظ في الأرشيف</button>
      <datalist id="dl-authors"></datalist><datalist id="dl-sources"></datalist><datalist id="dl-publishers"></datalist>
    </form>
  </div>

  <!-- قائمة المراجع، ونافذة عرض الصورة -->
  <dialog id="nb-dialog" class="m-auto w-[min(46rem,calc(100%-2rem))] max-h-[85vh] rounded-2xl bg-[var(--bg)] text-[var(--fg)] p-0 backdrop:bg-black/50" data-pagefind-ignore>
    <div class="flex items-center justify-between px-6 pt-5">
      <h2 class="text-[1.25rem]" id="nb-dialog-title"></h2>
      <button type="button" data-dialog-close class="w-9 h-9 rounded-full hover:bg-[var(--bg-2)] text-2xl leading-none" aria-label="إغلاق">×</button>
    </div>
    <div id="nb-dialog-body" class="px-6 pb-6 pt-3 overflow-y-auto"></div>
  </dialog>
  <div id="nb-toast" class="fixed bottom-6 inset-x-0 mx-auto w-max max-w-[90vw] z-[60] px-5 py-3 rounded-full bg-ink text-white shadow-lg text-[0.95rem] transition-opacity opacity-0 pointer-events-none" role="status"></div>

  <script>
    import "../scripts/notebook.ts";
  </script>
</Base>
