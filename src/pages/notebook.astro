---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
---
<Base title="مفكرة الباحث الذكية" description="مفكرة الباحث الذكية: أداة تساعد الباحث في تنظيم أفكاره وقراءاته ومصادره.">
  <PageHead title="مفكرة الباحث الذكية" lead="أداة تساعد الباحث في تنظيم أفكاره وقراءاته ومصادره. نعمل على إطلاقها قريبًا." />
  <section class="mx-auto max-w-3xl px-5 sm:px-8 pt-16 text-center">
    <svg viewBox="0 0 120 120" class="w-28 mx-auto" aria-hidden="true">
      <rect x="22" y="14" width="76" height="92" rx="10" fill="var(--bg-2)" stroke="var(--rule)" stroke-width="2" />
      <path d="M22 30h-6M22 50h-6M22 70h-6M22 90h-6" stroke="#c8962e" stroke-width="4" stroke-linecap="round" />
      <path d="M38 40h44M38 54h44M38 68h28" stroke="var(--muted)" stroke-width="3" stroke-linecap="round" opacity=".5" />
      <path d="M86 74l3 6 6 3-6 3-3 6-3-6-6-3 6-3z" fill="#c8962e" />
    </svg>
    <h2 class="mt-6 text-[1.7rem]">قريبًا</h2>
    <p class="mt-3 text-[1.08rem] leading-[2] text-[var(--muted)]">
      نعمل على تجهيز المفكرة. وإلى أن تُطلق، يمكنك قراءة المقالات أو تنزيل الدراسات المنشورة.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/articles/" class="no-underline px-6 py-3 rounded-full bg-indigo text-white font-medium hover:bg-indigo-deep dark:bg-saffron dark:text-ink">اقرأ المقالات</a>
      <a href="/studies/" class="no-underline px-6 py-3 rounded-full border border-[var(--rule)] hover:border-indigo">الدراسات المنشورة</a>
    </div>
  </section>
</Base>
