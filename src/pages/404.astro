---
import Base from "../layouts/Base.astro";
---
<Base title="الصفحة غير موجودة">
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pt-16 text-center">
    <h1 class="font-display font-bold text-4xl sm:text-5xl">الصفحة غير موجودة</h1>
    <p class="mt-4 text-[1.2rem] text-[var(--muted)]">ربما نُقلت الصفحة أو تغيّر رابطها.</p>
    <div class="mt-8 flex justify-center gap-3 font-display">
      <a href="/" class="no-underline px-5 py-2.5 rounded-md bg-indigo text-plaster">الصفحة الرئيسية</a>
      <a href="/articles/" class="no-underline px-5 py-2.5 rounded-md border border-[var(--rule)]">كل المقالات</a>
    </div>
  </section>
</Base>
