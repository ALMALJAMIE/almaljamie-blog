---
import Base from "../layouts/Base.astro";
import PostItem from "../components/PostItem.astro";
import StudyCard from "../components/StudyCard.astro";
import Portrait from "../components/Portrait.astro";
import ArchiveFeature from "../components/ArchiveFeature.astro";
import Subscribe from "../components/Subscribe.astro";
import { getCollection } from "astro:content";
import { getPosts, getStudies, arCount } from "../data/utils";
import { notebook, researchProfiles } from "../data/site";

const posts = await getPosts();
const studies = await getStudies();
const archiveCount = (await getCollection("infographics")).filter((i) => i.data.pdf || i.data.youtube).length;

const sections = [
  { href: "/articles/", title: "المقالات", text: "مقالات رأي وتحليل في الشأن اليمني، وفي محافظة البيضاء خاصة.", count: arCount(posts.length, "مقال واحد", "مقالان", "مقالات", "مقالًا"),
    icon: "M5 4h14v16H5zM8 8h8M8 12h8M8 16h5" },
  { href: "/studies/", title: "الدراسات المنشورة", text: "دراسات محكّمة وأعمال أكاديمية، متاحة للتنزيل مجانًا بصيغة PDF.", count: arCount(studies.length, "دراسة واحدة", "دراستان", "دراسات", "دراسة"),
    icon: "M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h5" },
  { href: "/cv/", title: "السيرة الذاتية", text: "المسار الأكاديمي، والاهتمامات البحثية، والمشاركات العلمية.", count: "",
    icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0" },
  { href: notebook.href, title: notebook.label, text: "أداة تساعد الباحث في تنظيم أفكاره وقراءاته ومصادره.", count: "قريبًا",
    icon: "M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11" },
];
---
<Base>
  <!-- الواجهة -->
  <section class="relative bg-indigo text-white overflow-hidden">
    <div class="absolute inset-0 pattern"></div>
    <div class="absolute -bottom-32 -start-32 w-[28rem] h-[28rem] rounded-full bg-saffron/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-5 sm:px-8 py-16 md:py-24 grid md:grid-cols-[1.25fr_1fr] gap-12 items-center">
      <div>
        <p class="text-saffron font-medium text-[1.05rem]">أهلًا بكم في الموقع الرسمي للباحث</p>
        <h1 class="mt-3 text-[2.1rem] sm:text-[2.5rem] lg:text-[2.9rem] leading-[1.35]">أحمد عباس الملجمي</h1>
        <p class="mt-4 flex flex-wrap gap-2 text-[0.92rem]">
          {["باحث في علم الاجتماع", "الأنثروبولوجيا", "الشأن اليمني", "كاتب مقالات"].map((t) => (
            <span class="px-3 py-1 rounded-full border border-white/20 bg-white/5">{t}</span>
          ))}
        </p>
        <p class="mt-6 text-[1.12rem] leading-[2] text-white/80 max-w-xl">
          باحث يمني من محافظة البيضاء، مقيم في كوالالمبور. أدرس المجتمع اليمني من الداخل: بنيته القبلية، وأعرافه، والعوامل التي صنعت طريقة تفكيره. وأعمل على مشروع بحثي بعنوان «محددات الذهنية اليمنية».
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/articles/" class="no-underline px-6 py-3 rounded-full bg-saffron text-ink font-bold hover:bg-white transition-colors">اقرأ المقالات</a>
          <a href="/studies/" class="no-underline px-6 py-3 rounded-full border border-white/30 hover:bg-white/10 transition-colors">حمّل الدراسات</a>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-2.5">
          <span class="text-white/60 text-[0.92rem] me-1">ملفاتي البحثية:</span>
          {researchProfiles.map((r) => (
            <a href={r.href} target="_blank" rel="noopener me" title={r.label} aria-label={`ملفي في ${r.label}`}
              class="group/r relative grid place-items-center w-10 h-10 rounded-full border border-white/20 bg-white/5 text-white/80 no-underline hover:bg-white hover:text-indigo hover:border-white transition-colors">
              {r.icon
                ? <svg viewBox="0 0 24 24" class="w-[18px] h-[18px]" fill="currentColor" aria-hidden="true"><path d={r.icon} /></svg>
                : <span class="font-bold text-[1rem] leading-none" aria-hidden="true">{r.letter}</span>}
              <span class="pointer-events-none absolute top-full mt-2 whitespace-nowrap rounded-md bg-ink/90 px-2 py-1 text-[0.78rem] text-white opacity-0 group-hover/r:opacity-100 group-focus-visible/r:opacity-100 transition-opacity">{r.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- الصورة داخل قوس القمرية -->
      <div class="relative mx-auto w-full max-w-[22rem]">
        <div class="absolute -inset-3 rounded-t-full border-2 border-saffron/60" aria-hidden="true"></div>
        <Portrait class="relative aspect-[4/5] rounded-t-full" size="text-[9rem]" />
        <div class="absolute -bottom-5 inset-x-6 rounded-xl bg-white text-ink px-5 py-3 shadow-xl flex items-center gap-3">
          <svg viewBox="0 0 80 52" class="w-10 shrink-0" aria-hidden="true">
            <path d="M2 50V40a38 38 0 0 1 76 0v10z" fill="#13294b" />
            <path d="M8 40a32 32 0 0 1 64 0z" fill="#c8962e" />
            <path d="M40 8v32M17.4 17.4 40 40M62.6 17.4 40 40" stroke="#fff" stroke-width="2.5" />
          </svg>
          <p class="text-[0.92rem] leading-snug"><span class="font-bold block">محددات الذهنية اليمنية</span><span class="text-stone">مشروع بحثي من ست دراسات</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- أقسام الموقع -->
  <section class="mx-auto max-w-7xl px-5 sm:px-8 -mt-0 pt-20">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {sections.map((s) => (
        <a href={s.href} class="group no-underline rounded-2xl border border-[var(--rule)] p-6 hover:border-indigo/40 hover:-translate-y-1 hover:shadow-[0_12px_32px_-12px_rgba(19,41,75,.25)] transition">
          <span class="grid place-items-center w-12 h-12 rounded-xl bg-indigo/8 text-indigo dark:bg-white/10 dark:text-saffron group-hover:bg-indigo group-hover:text-white transition-colors">
            <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
          </span>
          <h2 class="mt-5 text-[1.2rem]">{s.title}</h2>
          <p class="mt-2 text-[0.97rem] leading-[1.85] text-[var(--muted)]">{s.text}</p>
          {s.count && <p class="mt-4 text-[0.88rem] font-medium text-saffron">{s.count}</p>}
        </a>
      ))}
    </div>
  </section>

  <!-- أحدث المقالات -->
  {posts.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 sm:px-8 pt-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-[2rem]">أحدث المقالات</h2>
          <p class="mt-1 text-[var(--muted)]">ما كتبته مؤخرًا في الشأن اليمني.</p>
        </div>
        <a href="/articles/" class="font-medium text-indigo dark:text-saffron">كل المقالات</a>
      </div>
      <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.slice(0, 3).map((p) => <PostItem post={p} variant="card" />)}
      </div>
    </section>
  )}

  <!-- الدراسات -->
  {studies.length > 0 && (
    <section class="mt-24 bg-[var(--bg-2)] py-20">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-[2rem]">الدراسات المنشورة</h2>
            <p class="mt-1 text-[var(--muted)]">كل الدراسات متاحة للتنزيل مجانًا.</p>
          </div>
          <a href="/studies/" class="font-medium text-indigo dark:text-saffron">كل الدراسات</a>
        </div>
        <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {studies.slice(0, 3).map((s) => <StudyCard study={s} />)}
        </div>
      </div>
    </section>
  )}

  <!-- أرشيف الإنفوجرافيك -->
  {archiveCount > 0 && (
    <section class="mx-auto max-w-7xl px-5 sm:px-8 pt-24">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-[2rem]">أرشيف الإنفوجرافيك</h2>
          <p class="mt-1 text-[var(--muted)]">وثائق وتصاميم توضيحية رافقت المقالات والدراسات.</p>
        </div>
        <a href="/infographics/" class="font-medium text-indigo dark:text-saffron">كل الأرشيف</a>
      </div>
      <ArchiveFeature limit={1} class="mt-6" />
    </section>
  )}

  <!-- الاشتراك بالبريد -->
  <section class="mx-auto max-w-7xl px-5 sm:px-8 pt-24"><Subscribe variant="band" /></section>

  <!-- دعوة ختامية -->
  <section class="mx-auto max-w-7xl px-5 sm:px-8 pt-24">
    <div class="relative overflow-hidden rounded-3xl bg-indigo text-white px-8 py-14 md:px-14 text-center">
      <div class="absolute inset-0 pattern"></div>
      <h2 class="relative text-[1.8rem] sm:text-[2.2rem]">للتعليق على مقال، أو لدعوة إلى مشاركة بحثية أو إعلامية</h2>
      <p class="relative mt-3 text-white/75 text-[1.05rem]">يسعدني أن أسمع منك.</p>
      <a href="/contact/" class="relative inline-block mt-8 no-underline px-7 py-3 rounded-full bg-saffron text-ink font-bold hover:bg-white transition-colors">تواصل معي</a>
    </div>
  </section>
</Base>
